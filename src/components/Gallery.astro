---
import { type Lang, tr, useT } from '../i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section gallery" id="gallery">
  <div class="wrap">
    <header class="gallery__head">
      <p class="eyebrow">{t('gallery.eyebrow')}</p>
      <h2 class="gallery__title">{t('gallery.title')}</h2>
    </header>

    <ul class="gallery__grid">
      {site.gallery.map((g, i) => (
        <li class="gallery__item">
          <figure>
            <img src={g.image} alt={tr(g.caption, lang)} loading="lazy" decoding="async" />
            <figcaption class="mono">
              <span>{String(i + 1).padStart(2, '0')}</span>
              {tr(g.caption, lang)}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .gallery__head .eyebrow {
    order: 2;
    margin-bottom: 1rem;
  }

  .gallery__title {
    font-size: clamp(4rem, 12vw, 10rem);
  }

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(140px, 18vw, 230px);
    gap: 1rem;
  }

  .gallery__item {
    grid-column: span 5;
    grid-row: span 2;
  }

  .gallery__item:nth-child(4n + 1),
  .gallery__item:nth-child(4n + 4) {
    grid-column: span 7;
  }

  .gallery__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .gallery__item figure {
    margin: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: var(--ink);
  }

  .gallery__item figure::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }

  .gallery__item figcaption {
    z-index: 1;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.6s ease;
    filter: saturate(0.9) contrast(1.05);
  }

  .gallery__item:hover img {
    transform: scale(1.05);
    filter: saturate(1.15) contrast(1.05);
  }

  .gallery__item figcaption {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.7rem;
    color: var(--white);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
  }

  .gallery__item figcaption span {
    background: var(--orange);
    color: var(--black);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    text-shadow: none;
  }

  @media (max-width: 760px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 44vw;
    }

    .gallery__item,
    .gallery__item:nth-child(n) {
      grid-column: span 1;
      grid-row: span 1;
    }

    .gallery__item:nth-child(3n + 1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }
</style>
