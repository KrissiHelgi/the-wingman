---
import { Image } from 'astro:assets';
import truck from '../assets/truck-lot.jpg';
import { type Lang, useT } from '../i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const socials = [
  { label: 'Instagram', href: site.instagram },
  { label: 'Facebook', href: site.facebook },
].filter((s) => s.href);
---

<section class="section find" id="find-us">
  <div class="wrap find__inner">
    <div class="find__intro">
      <p class="eyebrow">{t('find.eyebrow')}</p>
      <h2 class="find__title">{t('find.title')}</h2>
      <p class="find__note">{t('find.followNote')}</p>
      {socials.length > 0 && (
        <div class="find__socials">
          {socials.map((s) => (
            <a class="btn btn--ghost" href={s.href} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      )}
    </div>

    <div class="find__photo">
      <Image src={truck} alt={lang === 'is' ? 'Wingman vagninn' : 'The Wingman truck'} widths={[400, 700]} sizes="(max-width: 960px) 90vw, 420px" />
      <span class="find__photo-tag mono">EST 2017 · REYKJAVÍK</span>
    </div>
  </div>
</section>

<style>
  .find__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .find__title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    color: var(--orange);
    margin: 0.75rem 0 1.25rem;
  }

  .find__note {
    color: rgba(255, 248, 240, 0.75);
    max-width: 34ch;
    margin: 0 0 1.75rem;
  }

  .find__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .find__photo {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    margin-inline: auto;
    transform: rotate(-2deg);
    border: 1px solid rgba(247, 134, 30, 0.35);
  }

  .find__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) contrast(1.05);
  }

  .find__photo-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    background: var(--orange);
    color: var(--black);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
  }

  @media (max-width: 960px) {
    .find__inner {
      grid-template-columns: 1fr;
    }

    .find__photo {
      max-width: 100%;
      aspect-ratio: 16 / 10;
      transform: none;
    }
  }
</style>
