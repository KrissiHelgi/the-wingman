---
import { Image } from 'astro:assets';
import truck from '../assets/truck-lot.jpg';
import { type Lang, tr, useT } from '../i18n';
import { schedule, site } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const today = new Date().toISOString().slice(0, 10);
const events = (schedule.events ?? [])
  .filter((e) => String(e.date) >= today)
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));

const fmtDate = (d: string) =>
  new Intl.DateTimeFormat(lang === 'is' ? 'is-IS' : 'en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  }).format(new Date(`${d}T12:00:00`));
---

<section class="section find" id="find-us">
  <div class="wrap find__inner">
    <div class="find__intro">
      <p class="eyebrow">{t('find.eyebrow')}</p>
      <h2 class="find__title">{t('find.title')}</h2>
      <p class="find__note">{t('find.followNote')}</p>
      {site.instagram && (
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      )}
      <div class="find__photo">
        <Image src={truck} alt={lang === 'is' ? 'Wingman vagninn' : 'The Wingman truck'} widths={[400, 700]} sizes="(max-width: 960px) 90vw, 420px" />
        <span class="find__photo-tag mono">EST 2017 · REYKJAVÍK</span>
      </div>
    </div>

    <div class="find__schedule">
      {events.length > 0 ? (
        <ol class="stops">
          {events.map((e) => (
            <li class:list={['stops__item', { 'is-today': String(e.date) === today }]}>
              <div class="stops__when">
                <span class="stops__date">{fmtDate(String(e.date))}</span>
                {String(e.date) === today && <span class="stops__badge mono">{t('find.today')}</span>}
              </div>
              <div class="stops__info">
                <span class="stops__name">{tr(e.title, lang)}</span>
                {e.place && <span class="stops__place">{e.place}</span>}
              </div>
              <div class="stops__meta">
                {e.hours && <span class="mono">{e.hours}</span>}
                {e.mapUrl && (
                  <a class="stops__map mono" href={e.mapUrl} target="_blank" rel="noopener">
                    {t('find.map')} ↗
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="find__empty">{t('find.empty')}</p>
      )}
    </div>
  </div>
</section>

<style>
  .find__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .find__title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    color: var(--orange);
    margin: 0.75rem 0 1.25rem;
  }

  .find__note {
    color: rgba(255, 248, 240, 0.75);
    max-width: 34ch;
    margin: 0 0 1.5rem;
  }

  .find__empty {
    margin: 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 248, 240, 0.15);
    color: rgba(255, 248, 240, 0.65);
    max-width: 36ch;
  }

  .find__photo {
    margin-top: 2.5rem;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    transform: rotate(-2deg);
    border: 1px solid rgba(247, 134, 30, 0.35);
  }

  .find__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.05);
  }

  .find__photo-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    background: var(--orange);
    color: var(--black);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
  }

  .stops {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 248, 240, 0.15);
  }

  .stops__item {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid rgba(255, 248, 240, 0.15);
  }

  .stops__when {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stops__date {
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--orange);
    line-height: 1.15;
  }

  .stops__badge {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .stops__name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .stops__place {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: rgba(255, 248, 240, 0.6);
  }

  .stops__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    text-align: right;
  }

  .stops__map {
    color: var(--orange);
    text-decoration: none;
  }

  .stops__map:hover {
    text-decoration: underline;
  }

  .stops__item.is-today {
    background: var(--orange);
    color: var(--black);
    border-radius: 18px;
    border-bottom-color: transparent;
  }

  .is-today .stops__date,
  .is-today .stops__map {
    color: var(--black);
  }

  .is-today .stops__place {
    color: rgba(11, 11, 11, 0.7);
  }

  @media (max-width: 960px) {
    .find__inner {
      grid-template-columns: 1fr;
    }

    .find__photo {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .stops__item {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .stops__when {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }

    .stops__info {
      min-width: 0;
    }
  }
</style>
