---
import { Image } from 'astro:assets';
import truck from '../assets/truck-lot.jpg';
import { type Lang, tr, useT } from '../i18n';
import { schedule, site } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const today = new Date().toISOString().slice(0, 10);
const events = (schedule.events ?? [])
  .filter((e) => String(e.date) >= today)
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));

const fmtDate = (d: string) =>
  new Intl.DateTimeFormat(lang === 'is' ? 'is-IS' : 'en-GB', { day: 'numeric', month: 'short' }).format(new Date(d));
---

<section class="section find" id="find-us">
  <div class="wrap find__inner">
    <div class="find__intro">
      <p class="eyebrow">{t('find.eyebrow')}</p>
      <h2 class="find__title">{t('find.title')}</h2>
      <p class="find__note">{t('find.followNote')}</p>
      {site.instagram && (
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      )}
      <div class="find__photo">
        <Image src={truck} alt={lang === 'is' ? 'Wingman vagninn' : 'The Wingman truck'} widths={[400, 700]} sizes="(max-width: 960px) 90vw, 420px" />
        <span class="find__photo-tag mono">EST 2017 · REYKJAVÍK</span>
      </div>
    </div>

    <div class="find__schedule">
      <ol class="week" data-week>
        {schedule.weekly.map((stop) => (
          <li class:list={['week__day', { 'is-closed': stop.closed }]} data-day={stop.day}>
            <div class="week__label">
              <span class="week__name">{t(`days.${stop.day}`)}</span>
              <span class="week__today mono">{t('find.today')}</span>
            </div>
            {stop.closed ? (
              <span class="week__closed mono">{t('find.closed')}</span>
            ) : (
              <div class="week__info">
                <span class="week__place">{stop.place}</span>
                {stop.address && <span class="week__address">{stop.address}</span>}
                {stop.note && <span class="week__address">{tr(stop.note, lang)}</span>}
              </div>
            )}
            <div class="week__meta">
              {stop.hours && !stop.closed && <span class="mono">{stop.hours}</span>}
              {stop.mapUrl && !stop.closed && (
                <a class="week__map mono" href={stop.mapUrl} target="_blank" rel="noopener">
                  {t('find.map')} ↗
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>

      {events.length > 0 && (
        <div class="events">
          <h3 class="events__title">{t('find.events')}</h3>
          <ul>
            {events.map((e) => (
              <li>
                <span class="events__date">{fmtDate(String(e.date))}</span>
                <span class="events__name">{tr(e.title, lang)}</span>
                <span class="mono">{[e.place, e.hours].filter(Boolean).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  const keys = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Atlantic/Reykjavik' }));
  document
    .querySelectorAll(`[data-week] [data-day="${keys[now.getDay()]}"]`)
    .forEach((el) => el.classList.add('is-today'));
</script>

<style>
  .find__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .find__title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    color: var(--orange);
    margin: 0.75rem 0 1.25rem;
  }

  .find__note {
    color: rgba(255, 248, 240, 0.75);
    max-width: 34ch;
    margin: 0 0 1.5rem;
  }

  .find__photo {
    margin-top: 2.5rem;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    transform: rotate(-2deg);
    border: 1px solid rgba(247, 134, 30, 0.35);
  }

  .find__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.05);
  }

  .find__photo-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    background: var(--orange);
    color: var(--black);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
  }

  .week {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 248, 240, 0.15);
  }

  .week__day {
    display: grid;
    grid-template-columns: 9.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1rem;
    border-bottom: 1px solid rgba(255, 248, 240, 0.15);
    transition: background 0.2s ease;
  }

  .week__label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .week__name {
    font-family: var(--font-brand);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.85rem;
  }

  .week__today {
    display: none;
    font-size: 0.65rem;
  }

  .week__place {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .week__address {
    display: block;
    font-size: 0.85rem;
    color: rgba(255, 248, 240, 0.6);
  }

  .week__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    text-align: right;
  }

  .week__map {
    color: var(--orange);
    text-decoration: none;
  }

  .week__map:hover {
    text-decoration: underline;
  }

  .week__closed {
    color: rgba(255, 248, 240, 0.35);
  }

  .is-closed .week__name {
    color: rgba(255, 248, 240, 0.35);
  }

  .week__day.is-today {
    background: var(--orange);
    color: var(--black);
    border-radius: 18px;
    border-bottom-color: transparent;
  }

  .is-today .week__today {
    display: inline;
  }

  .is-today .week__address,
  .is-today .week__closed,
  .is-today.is-closed .week__name,
  .is-today .week__map {
    color: rgba(11, 11, 11, 0.75);
  }

  .events {
    margin-top: 3rem;
    background: var(--ink);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .events__title {
    font-size: 1.9rem;
    color: var(--orange);
    margin-bottom: 1.25rem;
  }

  .events ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .events li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    column-gap: 1rem;
  }

  .events__date {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--orange);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .events__name {
    font-family: var(--font-brand);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .events li .mono {
    color: rgba(255, 248, 240, 0.6);
  }

  @media (max-width: 960px) {
    .find__inner {
      grid-template-columns: 1fr;
    }

    .find__photo {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .week__day {
      grid-template-columns: 1fr auto;
    }

    .week__label {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 0.75rem;
      align-items: baseline;
    }
  }
</style>
