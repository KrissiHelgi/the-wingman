---
import Trailer from './Trailer.astro';
import { type Lang, tr } from '../i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
  tone?: 'orange' | 'black';
  reverse?: boolean;
}
const { lang, tone = 'orange', reverse = false } = Astro.props;
const words = site.ticker.map((w) => tr(w, lang));
---

<div class="ticker-clip">
  <div class:list={['ticker', `ticker--${tone}`, { 'ticker--reverse': reverse }]} aria-label={words.join(', ')}>
    <div class="ticker__track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="ticker__group">
          {words.map((w) => (
            <>
              <span>{w}</span>
              <Trailer class="ticker__icon" />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Extra vertical padding so a rotated band isn’t shaved flat by overflow */
  .ticker-clip {
    overflow: hidden;
    width: 100%;
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .ticker {
    overflow: hidden;
    padding-block: 1rem;
    border-block: 2px solid var(--black);
    position: relative;
    z-index: 2;
    width: 110%;
    margin-inline: -5%;
  }

  .ticker--orange {
    background: var(--orange);
    color: var(--black);
    transform: rotate(-2.5deg);
  }

  .ticker--black {
    background: var(--black);
    color: var(--orange);
    border-color: var(--orange);
    transform: rotate(2.5deg);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .ticker--reverse .ticker__track {
    animation-direction: reverse;
  }

  .ticker__group {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
  }

  .ticker__group span {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .ticker__group :global(.ticker__icon) {
    width: 2.6rem;
    flex: none;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
