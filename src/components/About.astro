---
import { Image } from 'astro:assets';
import crowd from '../assets/truck-crowd.jpg';
import Stamp from './Stamp.astro';
import { type Lang, tr, useT } from '../i18n';
import { site } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section about" id="about">
  <div class="wrap about__inner">
    <figure class="about__frame">
      <div class="about__film mono" aria-hidden="true">
        <span>WINGMAN · 2017</span>
        <span>ISO 800 · 35MM</span>
      </div>
      <Image src={crowd} alt={lang === 'is' ? 'Fólk í röð við Wingman vagninn' : 'People queuing at the Wingman truck'} widths={[550]} sizes="(max-width: 960px) 90vw, 520px" />
      <div class="about__film mono" aria-hidden="true">
        <span>№ 01</span>
        <span>STREET FOOD</span>
      </div>
      <Stamp class="about__stamp" text={t('stamp.text')} />
    </figure>

    <div class="about__copy">
      <div class="about__heading">
        <h2 class="about__title">{t('about.title')}</h2>
        <p class="eyebrow">{t('about.eyebrow')}</p>
      </div>
      <p class="about__tagline">{tr(site.tagline, lang)}</p>
      {site.about.map((p) => <p class="about__p">{tr(p, lang)}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--ink);
    overflow-x: clip;
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .about__frame {
    position: relative;
    margin: 0;
    background: #050505;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    transform: rotate(-2.5deg);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
  }

  .about__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 40% 50%;
    filter: sepia(0.25) contrast(1.1) saturate(1.05);
  }

  .about__film {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    font-size: 0.62rem;
    color: var(--orange);
  }

  .about__frame :global(.stamp.about__stamp) {
    position: absolute;
    top: -2.5rem;
    left: -2.5rem;
    --size: 130px;
    box-shadow: 0 0 0 6px var(--ink);
  }

  .about__heading {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .about__title {
    font-size: clamp(4.5rem, 12vw, 10rem);
    color: var(--orange);
  }

  .about__heading .eyebrow {
    margin-bottom: 1.4rem;
    color: var(--white);
  }

  .about__tagline {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.05;
    margin: 1.5rem 0;
    max-width: 22ch;
  }

  .about__p {
    color: rgba(255, 248, 240, 0.75);
    max-width: 52ch;
    margin: 0 0 1rem;
  }

  @media (max-width: 960px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__frame {
      max-width: 440px;
      margin: 2rem auto 0;
    }

    .about__frame :global(.stamp.about__stamp) {
      left: auto;
      right: -1rem;
      --size: 104px;
    }
  }
</style>
