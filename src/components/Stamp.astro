---
import Trailer from './Trailer.astro';

interface Props {
  text: string;
  href?: string;
  label?: string;
  class?: string;
}
const { text, href, label, class: className } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['stamp', className]} href={href} aria-label={label}>
  <svg class="stamp__ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id={id} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
    </defs>
    <text>
      <textPath href={`#${id}`} textLength="462">{text}</textPath>
    </text>
  </svg>
  <span class:list={['stamp__center', { 'stamp__center--label': label }]}>
    {label ? <span class="stamp__label">{label}</span> : <Trailer class="stamp__icon" />}
  </span>
</Tag>

<style>
  .stamp {
    --size: 150px;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--orange);
    color: var(--black);
    display: grid;
    place-items: center;
    position: relative;
    text-decoration: none;
    box-shadow: 0 0 0 6px var(--black);
    transition: transform 0.3s ease;
  }

  a.stamp:hover {
    transform: scale(1.06) rotate(-6deg);
  }

  .stamp__ring {
    position: absolute;
    inset: 0;
    animation: spin 18s linear infinite;
  }

  .stamp__ring text {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 15.5px;
    letter-spacing: 0.08em;
    fill: currentColor;
  }

  .stamp__center {
    width: 52%;
    height: 52%;
    border-radius: 50%;
    border: 2px solid currentColor;
    display: grid;
    place-items: center;
    padding: 12%;
    box-sizing: border-box;
  }

  .stamp__center--label {
    padding: 0;
  }

  .stamp__center :global(.stamp__icon) {
    width: 100%;
  }

  .stamp__label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: calc(var(--size) * 0.105);
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
